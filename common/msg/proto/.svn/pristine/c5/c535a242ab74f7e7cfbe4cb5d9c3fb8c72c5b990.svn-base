syntax = "proto3";

option go_package = "./../message";
import "message_id.proto";

// C2S 800--900
// S2C 900--1000
enum Result {
    Success = 0;
    Fail = 1;
    Duplicate = 2;
    Illegal = 3;
}

message PlayerInfo {
    int32 server_id = 1;
    string player_name = 2;
    string avatar = 3;
    int32 level = 4;
    string playerId = 5;
}



// 获取玩家信息请求
message C2S_GetPlayerInfo {
    option (message_id) = 801;
    int32 type = 1;
}
;
// 获取玩家信息响应
message S2C_GetPlayerInfo {
    option (message_id) = 901;
    PlayerInfo playerInfo = 1;
}

// 检验玩家名是否合法
message C2S_CheckName {
    option (message_id) = 802;
    string name = 1;
}

message S2C_CheckName {
    option (message_id) = 902;
    Result result = 1;
}

// 修改玩家名
message C2S_ModifyName {
    option (message_id) = 803;
    string name = 1;
}

message S2C_ModifyName {
    option (message_id) = 903;
    Result result = 1;
    string name = 2;
}

// 看广告
message C2S_WatchAd {
    option (message_id) = 804;
    AdType type = 1;
}


enum AdType {
    AD_None = 0;
    AD_AdventureGold = 1;
}


message SaveData {
    SaveType type = 1;
    string   unique_id = 2; // id条件限制
    string   data = 3;
}

message QueryData {
    SaveType type = 1;
    string   unique_id = 2; // id条件限制
}

// 存储数据
message C2S_SaveData {
    option (message_id) = 805;
    repeated SaveData save_datas = 1;
}

message S2C_SaveData {
    option (message_id) = 905;
    int32 result = 1;// 存储成功 0为成功 1为失败
}

// 查询数据
message C2S_QueryData {
    option (message_id) = 806;
    repeated QueryData query_data = 1;
}

message S2C_QueryData {
    option (message_id) = 906;
    repeated SaveData query_datas = 1;
}

enum UploadType {
    UploadType_None = 0;
    UploadType_Avatar = 1;
}

// 获取上传url
message C2S_GetUploadUrl {
    option (message_id) = 807;
    UploadType type = 1;
    string suffixName = 2; // 文件类型 jpg/png
}

message S2C_GetUploadUrl {
    option (message_id) = 907;
    string url = 1;
}

// 修改头像路径
message C2S_ModifyAvatar {
    option (message_id) = 808;
    string avatar = 1;
}

message S2C_ModifyAvatar {
    option (message_id) = 908;
    Result result = 1;
    string avatar = 2;
}

enum SaveType {
    SaveType_None = 0;
    SaveType_GameSaveInfo = 1;
    SaveType_PlayerInfo = 2;
}

