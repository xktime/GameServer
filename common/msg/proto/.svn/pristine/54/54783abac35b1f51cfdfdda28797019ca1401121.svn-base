syntax = "proto3";

option go_package = "./../message";
import "message_id.proto";

// C2S 100--199
// S2C 200--299
enum LoginType {
    None = 0;
    DouYin = 1;
    WeChat = 2;
}

message LoginInfo {
    string openId = 1;
    int32 lastLoginTime = 2;
    int32 totalDays = 3;
    bool isAccept = 4;
}

message S2C_Login {
    option (message_id) = 201;
    int32 login_result = 1; // 成功为1 失败为-1
    LoginInfo login_info = 2;
}

// client -> server -> toDouyinCheck
message C2S_Login {
    option (message_id) = 101;
    LoginType login_type = 1;
    int32 server_id = 2;
    string code = 3;
}

message C2S_Heart {
    option (message_id) = 102;
}

message S2C_Heart {
    option (message_id) = 202;
    int32 timestamp = 1;
}

message S2C_Logout {
    option (message_id) = 204;
}
